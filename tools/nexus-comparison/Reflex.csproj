<Project Sdk="Microsoft.NET.Sdk"><PropertyGroup><TargetFramework>netstandard2.1</TargetFramework><LangVersion>latest</LangVersion><EnableDefaultCompileItems>false</EnableDefaultCompileItems><AssemblyName>Reflex</AssemblyName><!-- ENABLE_MONO mirrors what Unity defines in a Mono player: Reflex then uses its MonoActivatorFactory (compiled expression trees). Without any backend define its ActivatorFactoryManager throws. --><DefineConstants>$(DefineConstants);ENABLE_MONO</DefineConstants><NoWarn>$(NoWarn);CS8632</NoWarn></PropertyGroup><ItemGroup><!-- Core DI only. Excluded: scene/GameObject injectors, ContainerScope (MonoBehaviour), the ReflexSettings ScriptableObject and the Unity logger (ReflexHostShims.cs supplies a silent logger and the few UnityEngine types the core files reference). The library is not edited. --><Compile Include="competitors/Reflex/Assets/Reflex/**/*.cs" Exclude="competitors/Reflex/Assets/Reflex/Editor/**/*.cs;competitors/Reflex/Assets/Reflex/Components/**/*.cs;competitors/Reflex/Assets/Reflex/Configuration/**/*.cs;competitors/Reflex/Assets/Reflex/Core/ContainerScope.cs;competitors/Reflex/Assets/Reflex/Exceptions/SceneHasMultipleSceneScopesException.cs;competitors/Reflex/Assets/Reflex/Extensions/SceneExtensions.cs;competitors/Reflex/Assets/Reflex/Injectors/GameObjectInjector.cs;competitors/Reflex/Assets/Reflex/Injectors/SceneInjector.cs;competitors/Reflex/Assets/Reflex/Injectors/UnityInjector.cs;competitors/Reflex/Assets/Reflex/Logging/ReflexLogger.cs" /><Compile Include="ReflexHostShims.cs" /></ItemGroup></Project>
