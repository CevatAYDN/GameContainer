    <AssemblyName>NexusBenchmark</AssemblyName>
    <RootNamespace>NexusBench</RootNamespace>
    <DefineConstants>NEXUS_DEBUG</DefineConstants>
    <Optimize>true</Optimize>
    <TieredCompilation>false</TieredCompilation>
