<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>netstandard2.1</TargetFramework>
    <LangVersion>9.0</LangVersion>
    <Nullable>disable</Nullable>
    <ImplicitUsings>disable</ImplicitUsings>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <!-- The installed editor's engine modules; pass -p:UNITY_MODULES=<...\Data\Managed\UnityEngine\> for another install. -->
    <UNITY_MODULES Condition="'$(UNITY_MODULES)' == ''">C:\Program Files\Unity\Hub\Editor\6000.6.8f1\Editor\Data\Managed\UnityEngine\</UNITY_MODULES>
    <UNITY_COLLECTIONS_DLL Condition="'$(UNITY_COLLECTIONS_DLL)' == ''">..\..\Nexus\Library\ScriptAssemblies\Unity.Collections.dll</UNITY_COLLECTIONS_DLL>
    <UNITY_INPUTSYSTEM_DLL Condition="'$(UNITY_INPUTSYSTEM_DLL)' == ''">..\..\Nexus\Library\ScriptAssemblies\Unity.InputSystem.dll</UNITY_INPUTSYSTEM_DLL>
    <UNITY_UGUI_DLL Condition="'$(UNITY_UGUI_DLL)' == '' and Exists('$(UNITY_UGUI)UnityEngine.UI.dll')">$(UNITY_UGUI)UnityEngine.UI.dll</UNITY_UGUI_DLL>
    <UNITY_UGUI_DLL Condition="'$(UNITY_UGUI_DLL)' == ''">..\..\Nexus\Library\ScriptAssemblies\UnityEngine.UI.dll</UNITY_UGUI_DLL>
    <!-- What Unity defines in every player and the editor; com.nexus.dots compiles with com.unity.collections and the
         input service with the Input System the core depends on (#198). -->
    <DefineConstants>UNITY_6000;UNITY_6000_5_OR_NEWER;UNITY_5_3_OR_NEWER;UNITY_COLLECTIONS;UNITY_INPUT_SYSTEM;ENABLE_INPUT_SYSTEM;ENABLE_LEGACY_INPUT_MANAGER</DefineConstants>
    <NoWarn>CS0067;CS0649;CS0414;CS0219;CS8019</NoWarn>
    <WarningLevel>4</WarningLevel>
    <Deterministic>true</Deterministic>
    <AssemblyName>com.nexus.core</AssemblyName>
  </PropertyGroup>

  <!-- Variants (#198): the default build is a release player; "editor" adds the development and editor branches,
       "android" and "ios" the IL2CPP device branches. A build without -p:Variant builds all four. -->
  <PropertyGroup Condition="'$(Variant)' == 'editor'">
    <DefineConstants>$(DefineConstants);NEXUS_DEBUG;UNITY_EDITOR;UNITY_STANDALONE;ENABLE_PROFILER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Variant)' == 'android'">
    <DefineConstants>$(DefineConstants);NEXUS_DEBUG;UNITY_ANDROID;ENABLE_IL2CPP;ENABLE_PROFILER</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Variant)' == 'ios'">
    <DefineConstants>$(DefineConstants);UNITY_IOS;ENABLE_IL2CPP</DefineConstants>
  </PropertyGroup>
  <PropertyGroup Condition="'$(Variant)' != ''">
    <IntermediateOutputPath>obj\$(Variant)\</IntermediateOutputPath>
    <OutputPath>bin\$(Variant)\</OutputPath>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="..\..\Nexus\Packages\com.nexus.core\Runtime\**\*.cs" />
    <!-- Split from the core in #112. Built into this one assembly, so their access to core internals is checked
         by Unity's own compile (gate 3), not here. -->
    <Compile Include="..\..\Nexus\Packages\com.nexus.fsm\Runtime\**\*.cs" />
    <Compile Include="..\..\Nexus\Packages\com.nexus.dots\Runtime\**\*.cs" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="$(UNITY_MODULES)UnityEngine.CoreModule.dll" />
    <Reference Include="..\..\Nexus\Library\ScriptAssemblies\Unity.Profiling.Core.dll" />
    <Reference Include="$(UNITY_MODULES)Unity.Scripting.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.ScriptingModule.dll" /><!-- PreserveAttribute; UnityEngine.SharedInternalsModule until 6000.5 -->
    <Reference Include="$(UNITY_MODULES)UnityEngine.AudioModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.UIModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.UIElementsModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.TextRenderingModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.TextCoreTextEngineModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.TextCoreFontEngineModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.IMGUIModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.PhysicsModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.Physics2DModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.AnimationModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.InputModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.InputLegacyModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.InputForUIModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.JSONSerializeModule.dll" />
    <!-- System.Text.Json ships with the editor for netstandard2.1 (JsonLocalizationTableProvider). -->
    <Reference Include="$(UNITY_MODULES)..\..\BCLExtensions\TargetingPacks\netstandard2.1\ref\System.Text.Json.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.UnityWebRequestModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.UnityWebRequestWWWModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.ScreenCaptureModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.ParticleSystemModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.VFXModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.VideoModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.DirectorModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.MathematicsModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.HierarchyCoreModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.IdentifiersModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.MultiplayerModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.UnityAnalyticsModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.UnityAnalyticsCommonModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.AIModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.AccessibilityModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.ImageConversionModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.AssetBundleModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.UnityCurlModule.dll" />
    <Reference Include="$(UNITY_MODULES)UnityEngine.TLSModule.dll" />
    <Reference Include="$(UNITY_UGUI_DLL)" />
    <Reference Include="$(UNITY_COLLECTIONS_DLL)" />
    <Reference Include="$(UNITY_INPUTSYSTEM_DLL)" />
  </ItemGroup>
  <ItemGroup Condition="'$(Variant)' == 'editor'">
    <Reference Include="$(UNITY_MODULES)UnityEditor.CoreModule.dll" />
  </ItemGroup>
  <ItemGroup Condition="'$(Variant)' == 'android'">
    <Reference Include="$(UNITY_MODULES)UnityEngine.AndroidJNIModule.dll" />
  </ItemGroup>

  <!-- A missing assembly stops the check instead of compiling less than it claims (#198). -->
  <Target Name="RequireUnityAssemblies" BeforeTargets="ResolveAssemblyReferences">
    <Error Condition="!Exists('$(UNITY_MODULES)UnityEngine.CoreModule.dll')" Text="No engine modules at $(UNITY_MODULES): install Unity 6000.6.8f1 or pass -p:UNITY_MODULES=..." />
    <Error Condition="!Exists('$(UNITY_COLLECTIONS_DLL)') or !Exists('$(UNITY_UGUI_DLL)') or !Exists('$(UNITY_INPUTSYSTEM_DLL)')" Text="Nexus/Library/ScriptAssemblies lacks Unity.Collections, UnityEngine.UI or Unity.InputSystem: open or batch-compile the Nexus project once." />
  </Target>

  <Target Name="CompileVariants" AfterTargets="Build" Condition="'$(Variant)' == ''">
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="Variant=editor;Configuration=$(Configuration)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="Variant=android;Configuration=$(Configuration)" />
    <MSBuild Projects="$(MSBuildProjectFullPath)" Targets="Build" Properties="Variant=ios;Configuration=$(Configuration)" />
  </Target>

</Project>
