{
    "name": "com.nexus.firebase.tests",
    "rootNamespace": "Nexus.Firebase.Tests",
    "references": [
        "com.nexus.core",
        "com.nexus.firebase",
        "com.nexus.firebase.editor",
        "com.nexus.core.testing",
        "UnityEngine.TestRunner",
        "UnityEditor.TestRunner"
    ],
    "includePlatforms": [
        "Editor"
    ],
    "excludePlatforms": [],
    "allowUnsafeCode": false,
    "overrideReferences": true,
    "precompiledReferences": [
        "nunit.framework.dll"
    ],
    "autoReferenced": false,
    "defineConstraints": [
        "UNITY_INCLUDE_TESTS"
    ],
    "versionDefines": [
        {
            "name": "com.google.firebase.remote-config",
            "expression": "14.0.0",
            "define": "NEXUS_FIREBASE_REMOTE_CONFIG"
        }
    ],
    "noEngineReferences": false
}
