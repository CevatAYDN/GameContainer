<linker>
  <!-- 
    Nexus.Core AOT/IL2CPP Preservation
    Plan §6.2: Nexus uses reflection-heavy patterns (DI injection, attribute scanning,
    generic dispatch) which IL2CPP would strip without explicit preservation rules.
  -->
  <assembly fullname="com.nexus.core">
    <!-- Attributes scanned at runtime -->
    <type fullname="Nexus.Core.SignalHandlerAttribute" preserve="all"/>
    <type fullname="Nexus.Core.CompositeSignalHandlerAttribute" preserve="all"/>
    <!-- The RegisterCommand pair is scanned by exactly the same assembly walk as the
         SignalHandler pair above and must be preserved with it. -->
    <type fullname="Nexus.Core.RegisterCommandAttribute" preserve="all"/>
    <type fullname="Nexus.Core.RegisterCompositeCommandAttribute" preserve="all"/>
    <type fullname="Nexus.Core.InjectAttribute" preserve="all"/>
    <type fullname="Nexus.Core.OptionalInjectAttribute" preserve="all"/>
    <type fullname="Nexus.Core.PostConstructAttribute" preserve="all"/>
    <type fullname="Nexus.Core.DeconstructAttribute" preserve="all"/>
    <type fullname="Nexus.Core.ConstructAttribute" preserve="all"/>
    <type fullname="Nexus.Core.MediatorAttribute" preserve="all"/>
    <type fullname="Nexus.Core.CommandTimeoutAttribute" preserve="all"/>
    <type fullname="Nexus.Core.CrossContextAttribute" preserve="all"/>
    <type fullname="Nexus.Core.ContextDependsOnAttribute" preserve="all"/>
    <type fullname="Nexus.Core.StubServiceAttribute" preserve="all"/>
    
    <!-- Core types instantiated or inspected via reflection -->
    <type fullname="Nexus.Core.Context" preserve="all"/>
    <type fullname="Nexus.Core.SignalBus" preserve="all"/>
    <type fullname="Nexus.Core.NexusDI" preserve="all"/>
    <type fullname="Nexus.Core.Root" preserve="all"/>
    <type fullname="Nexus.Core.View" preserve="all"/>
    <type fullname="Nexus.Core.ViewBinder" preserve="all"/>
    <type fullname="Nexus.Core.CommandHandlerInfo" preserve="all"/>
    <type fullname="Nexus.Core.CompositeTriggerState" preserve="all"/>
    <!-- Its Bind* methods implement interface methods overloaded only by generic arity (BindReactiveModel<T> and
         BindReactiveModel<TInterface, TImplementation>). At Medium and High stripping UnityLinker kept the first declared of
         each pair and removed the other while keeping the interface method, so a game's call threw
         EntryPointNotFoundException (#113). Harness CG8 requires this for every such implementation. -->
    <type fullname="Nexus.Core.ContextBuilder" preserve="all"/>

    <!-- The services a game binds and the reflection path constructs. A game's generated link.xml lists
         no package type (#110), so the package preserves them here. -->
    <namespace fullname="Nexus.Core.Services" preserve="all"/>
  </assembly>

  <!-- Compiled only with com.unity.collections (UNITY_COLLECTIONS). -->
  <assembly fullname="com.nexus.core.dots" preserve="all" ignoreIfMissing="true"/>

  <!-- P1-13 fix: preserve UnityEngine.UI types accessed by WindowManager at runtime -->
  <assembly fullname="UnityEngine.UI" ignoreIfMissing="true">
    <type fullname="UnityEngine.UI.CanvasScaler" preserve="all"/>
    <type fullname="UnityEngine.UI.GraphicRaycaster" preserve="all"/>
  </assembly>
</linker>
