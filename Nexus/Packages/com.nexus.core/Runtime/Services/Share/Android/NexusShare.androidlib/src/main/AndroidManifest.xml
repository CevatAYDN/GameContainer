<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <application>
        <!-- ShareService (#134): content:// URIs for shared files; the authority is the app's id plus .nexusfileprovider -->
        <provider
            android:name="com.nexus.share.NexusFileProvider"
            android:authorities="${applicationId}.nexusfileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/nexus_share_paths" />
        </provider>
    </application>
</manifest>
