/* Nexus Theme v3 — Clean, readable, responsive USS Stylesheet
   All plugins MUST use these classes instead of inline styles.
   Design tokens: surface/text/accent colors match NexusEditorStyles.cs. */

/* ─── Layout ─── */
.nexus-root {
    flex-direction: row;
    background-color: rgb(35, 35, 42);
}
.nexus-right-panel {
    flex-grow: 1;
    flex-direction: column;
    min-width: 0;
}
.nexus-scroll-content {
    padding: 16px 20px;
}

/* ─── Sidebar ─── */
.nexus-sidebar {
    width: 200px;
    min-width: 180px;
    max-width: 220px;
    background-color: rgb(25, 25, 30);
    border-right-color: rgb(51, 51, 56);
    border-right-width: 1px;
    padding-top: 20px;
    padding-left: 8px;
    padding-right: 8px;
    flex-shrink: 0;
}
.nexus-brand-title {
    font-size: 22px;
    -unity-font-style: bold;
    color: rgb(77, 204, 255);
    margin-bottom: 2px;
    align-self: center;
    letter-spacing: 3px;
    white-space: nowrap;
}
.nexus-brand-subtitle {
    font-size: 9px;
    color: rgb(153, 153, 153);
    margin-bottom: 24px;
    align-self: center;
    letter-spacing: 1px;
}
.nexus-sidebar-separator {
    height: 1px;
    background-color: rgb(51, 51, 56);
    margin: 0 4px 8px;
}
.nexus-category-header {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(102, 102, 102);
    letter-spacing: 1px;
    margin-top: 12px;
    margin-bottom: 2px;
    margin-left: 6px;

}
.nexus-sidebar-btn {
    background-color: rgba(0, 0, 0, 0);
    color: rgb(217, 217, 217);
    font-size: 11px;
    padding: 8px 12px;
    border-radius: 4px;
    border-width: 0;
    margin: 2px 0;
    align-items: center;
    flex-direction: row;
    transition: background-color 0.15s, color 0.15s;
    -unity-font-style: normal;
    cursor: link;
}
.nexus-sidebar-btn:hover {
    background-color: rgb(40, 40, 45);
}
.nexus-sidebar-btn:active,
.nexus-sidebar-btn.active {
    background-color: rgb(46, 56, 71);
    color: rgb(77, 204, 255);
    -unity-font-style: bold;
}
/* sidebar-btn active label color handled via .active on btn */
.nexus-sidebar-label {
    font-size: 11px;
    color: rgb(217, 217, 217);
}

/* ─── Language Selector ─── */
.nexus-lang-container {
    flex-direction: row;
    justify-content: center;
    margin-bottom: 12px;
    padding-top: 8px;
    border-top-width: 1px;
    border-top-color: rgb(51, 51, 56);
}
.nexus-lang-btn {
    font-size: 9px;
    padding: 2px 8px;
    border-radius: 0;
    border-width: 1px;
    border-color: rgb(51, 51, 56);
    background-color: rgba(0, 0, 0, 0);
    color: rgb(153, 153, 153);
    flex-shrink: 0;
}
.nexus-lang-btn.first {
    border-top-left-radius: 3px;
    border-bottom-left-radius: 3px;
    border-right-width: 0;
}
.nexus-lang-btn.last {
    border-top-right-radius: 3px;
    border-bottom-right-radius: 3px;
    border-left-width: 0;
}
.nexus-lang-btn.active {
    background-color: rgb(46, 56, 71);
    color: rgb(77, 204, 255);
    -unity-font-style: bold;
}
.nexus-version-label {
    font-size: 9px;
    color: rgb(102, 102, 102);
    align-self: center;
    margin-bottom: 8px;
    padding-top: 4px;
}

/* ─── Toolbar ─── */
.nexus-toolbar {
    flex-direction: row;
    flex-wrap: wrap;
    background-color: rgb(25, 25, 30);
    padding: 8px 12px;
    border-bottom-color: rgb(51, 51, 56);
    border-bottom-width: 1px;
    align-items: center;
    min-height: 32px;
}
.nexus-toolbar-title {
    -unity-font-style: bold;
    font-size: 12px;
    color: rgb(77, 204, 255);
    margin-right: 16px;
    white-space: nowrap;
}
.nexus-toolbar-btn {
    background-color: rgb(64, 64, 69);
    color: white;
    font-size: 9px;
    -unity-font-style: bold;
    padding: 3px 10px;
    border-radius: 4px;
    border-width: 0;
    margin-left: 5px;
    white-space: nowrap;
    cursor: link;
    transition: background-color 0.15s;
}
.nexus-toolbar-btn:hover {
    background-color: rgb(77, 77, 82);
}

/* ─── Context Action Bar ─── */
.nexus-actionbar {
    flex-direction: row;
    flex-wrap: wrap;
    align-items: center;
    padding: 6px 12px;
    background-color: rgb(35, 35, 42);
    border-bottom-color: rgb(51, 51, 56);
    border-bottom-width: 1px;
    min-height: 28px;
}
.nexus-actionbar-label {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(77, 204, 255);
    margin-right: 12px;
    white-space: nowrap;
}
.nexus-actionbar-btn {
    margin-right: 6px;
    padding: 3px 8px;
    font-size: 9px;
    -unity-font-style: bold;
    color: white;
    border-radius: 3px;
    border-width: 0;
    white-space: nowrap;
    cursor: link;
    transition: opacity 0.15s;
}
.nexus-actionbar-btn:hover {
    opacity: 0.85;
}
.nexus-actionbar-status {
    font-size: 8px;
    -unity-font-style: bold;
    padding: 1px 6px;
    border-radius: 2px;
    margin-left: 6px;
    white-space: nowrap;
}

/* ─── Status Bar ─── */
.nexus-statusbar {
    background-color: rgb(25, 25, 30);
    color: rgb(153, 153, 153);
    font-size: 10px;
    padding: 4px 12px;
    border-top-color: rgb(51, 51, 56);
    border-top-width: 1px;
    -unity-font-style: bold;
    white-space: nowrap;
    overflow: hidden;
    flex-shrink: 0;
}

/* ─── Cards ─── */
.nexus-card {
    padding: 12px 14px;
    border-radius: 6px;
    margin-bottom: 8px;
    background-color: rgb(46, 46, 51);
    flex-shrink: 0;
}
/* ─── Section Title ─── */
.nexus-section-title {
    font-size: 10px;
    -unity-font-style: bold;
    color: rgb(153, 153, 153);
    margin-bottom: 6px;
}
/* ─── Stat Boxes ─── */
.nexus-stat-box {
    flex-grow: 1;
    align-items: center;
    padding: 2px 4px;
}
.nexus-stat-value {
    font-size: 22px;
    -unity-font-style: bold;
    margin-bottom: 2px;
}
.nexus-stat-label {
    font-size: 8px;
    color: rgb(153, 153, 153);
    margin-bottom: 2px;
}
.nexus-stat-tile {
    width: 140px;
    min-height: 72px;
    background-color: rgb(46, 46, 51);
    border-radius: 6px;
    margin: 4px;
    padding: 6px 8px;
    border-left-width: 3px;
}
.nexus-stat-tile-value {
    font-size: 20px;
    -unity-font-style: bold;
}
.nexus-stat-tile-label {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(153, 153, 153);
    margin-top: 2px;
}
.nexus-stat-tile-desc {
    font-size: 8px;
    color: rgb(102, 102, 102);
    margin-top: 2px;
    white-space: normal;
}

/* ─── Buttons ─── */
.nexus-btn {
    color: white;
    font-size: 10px;
    -unity-font-style: bold;
    padding: 5px 12px;
    border-radius: 4px;
    border-width: 0;
    margin: 4px 6px 4px 0;
    align-items: center;
    flex-direction: row;
    white-space: nowrap;
    cursor: link;
    transition: opacity 0.15s;
}
.nexus-btn:hover { opacity: 0.85; }
.nexus-btn:active { opacity: 0.7; }

/* ─── Metric Jump Buttons ─── */
.nexus-metric-btn {
    margin: 4px 6px 0 0;
    padding: 4px 8px;
    border-radius: 4px;
    border-width: 0;
    color: white;
    -unity-font-style: bold;
    font-size: 9px;
    cursor: link;
    transition: opacity 0.15s, background-color 0.15s;
}
.nexus-metric-btn:hover { opacity: 0.85; }

/* ─── Badges / Pills ─── */
.nexus-pill {
    font-size: 8px;
    -unity-font-style: bold;
    padding: 1px 5px;
    border-radius: 3px;
    margin: 0 2px 0 6px;
    white-space: nowrap;
}
/* ─── Status Dot ─── */
.nexus-status-dot {
    width: 8px;
    height: 8px;
    border-radius: 4px;
    margin-right: 8px;
    flex-shrink: 0;
}

/* ─── Empty State ─── */
.nexus-empty-state {
    color: rgb(153, 153, 153);
    font-size: 11px;
    align-self: center;
    margin: 30px 0 10px;
}

/* ─── Live Badge ─── */
.nexus-live-badge {
    font-size: 9px;
    -unity-font-style: bold;
    padding: 2px 6px;
    border-radius: 3px;
    background-color: rgb(25, 76, 25);
    color: rgb(102, 255, 102);
}

/* ─── Data Table ─── */
.nexus-table-header {
    flex-direction: row;
    padding: 5px 8px;
    background-color: rgb(41, 41, 46);
    border-bottom-color: rgb(64, 64, 69);
    border-bottom-width: 1px;
    border-radius: 4px;
    margin-top: 5px;
}
.nexus-table-header-text {
    font-size: 9px;
    -unity-font-style: bold;
    color: rgb(153, 153, 153);
}
.nexus-table-row {
    flex-direction: row;
    padding: 4px 8px;
}
.nexus-table-row { background-color: rgb(46, 46, 51); }
.nexus-table-row.alt { background-color: rgb(41, 41, 46); }
.nexus-table-row:hover { background-color: rgb(51, 51, 58); }
.nexus-table-cell {
    font-size: 9px;
    color: rgb(217, 217, 217);
    overflow: hidden;
    white-space: nowrap;
}

/* ─── Search Row & Field ─── */
.nexus-search-field {
    flex-grow: 1;
    height: 22px;
    font-size: 10px;
    margin-right: 8px;
}
/* ─── Filter Bar ─── */
.nexus-filter-btn {
    font-size: 8px;
    padding: 1px 5px;
    margin: 0 2px;
    border-radius: 3px;
    border-width: 0;
    cursor: link;
}
.nexus-filter-btn.active { background-color: rgb(51, 89, 128); color: white; }
.nexus-filter-btn.inactive { background-color: rgb(38, 38, 43); color: rgb(102, 102, 102); }
.nexus-filter-btn:hover { background-color: rgb(51, 51, 58); }
/* ─── Stat Row (key:value pair) ─── */
.nexus-stat-row {
    flex-direction: row;
    justify-content: space-between;
    padding: 3px 8px;
    border-bottom-width: 1px;
    border-bottom-color: rgb(51, 51, 56);
}
/* ─── Welcome/Status Card ─── */
.nexus-status-card-title {
    font-size: 16px;
    -unity-font-style: bold;
}
.nexus-status-hint {
    font-size: 10px !important;
    color: rgb(153, 153, 153);
    margin-top: 8px;
    white-space: normal;
}

/* ─── Quick Action Group ─── */
.nexus-actions-row {
    flex-direction: row;
    flex-wrap: wrap;
    margin: 5px 0 0 15px;
}
/* ─── Discovery Error ─── */
.nexus-discovery-error {
    color: rgb(255, 77, 77);
    -unity-text-align: middle-center;
    margin-top: 12px;
    white-space: normal;
}
.nexus-discovery-info {
    color: rgb(153, 153, 153);
    -unity-text-align: middle-center;
    margin-top: 12px;
}

/* ─── Plugin Icon ─── */
.nexus-plugin-icon {
    width: 16px;
    height: 16px;
    border-radius: 8px;
    margin-right: 8px;
    flex-shrink: 0;
}

